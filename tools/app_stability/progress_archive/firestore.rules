// ISOLATED EMULATOR CANDIDATE ONLY. Not a replacement for app/live rules.
// Immutable private legacy evidence; NEVER an authoritative wallet/award.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProgressAccount(accountKey) {
      return request.auth != null
        && accountKey.matches('^[0-9]+$')
        && exists(/databases/$(database)/documents/deda_sessions/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/deda_sessions/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/deda_sessions/$(request.auth.uid)).data.accountKey == accountKey
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountKey == accountKey;
    }
    function validLegacyText(value) {
      return value == null || (value is string && value.size() <= 200000);
    }
    function validEvidence(accountKey, captureId) {
      let d = request.resource.data;
      return captureId.matches('^[A-Za-z0-9_-]{20,80}$')
        && d.keys().hasAll(['format','kind','accountKey','sourceUid','installId','captureId','records','createdAt'])
        && d.keys().hasOnly(['format','kind','accountKey','sourceUid','installId','captureId','records','createdAt'])
        && d.format == 1 && d.kind == 'legacy-local-evidence'
        && d.accountKey == accountKey && d.captureId == captureId
        && d.sourceUid == request.auth.uid
        && d.installId is string && d.installId.size() > 0 && d.installId.size() <= 128
        && d.installId == get(/databases/$(database)/documents/deda_sessions/$(request.auth.uid)).data.installId
        && d.createdAt == request.time
        && d.records is map
        && d.records.keys().hasAll(['taskPoints','socialCoinsAndXp','earnedDiamonds'])
        && d.records.keys().hasOnly(['taskPoints','socialCoinsAndXp','earnedDiamonds'])
        && validLegacyText(d.records.taskPoints)
        && validLegacyText(d.records.socialCoinsAndXp)
        && validLegacyText(d.records.earnedDiamonds);
    }
    function ownsPurchaseOriginal(accountKey, originalId) {
      let route = get(/databases/$(database)/documents/deda_share_ids/$(originalId)).data;
      return originalId.matches('^@DEDA-[A-Z0-9]{6}$')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sharePersonalId == originalId
        && route.publicId == originalId && route.kind == 'personal' && route.active == true
        && route.ownerUid is string
        && get(/databases/$(database)/documents/users/$(route.ownerUid)).data.accountKey == accountKey;
    }
    function validPurchaseEvidence(accountKey, captureId) {
      let d = request.resource.data;
      let p = get(/databases/$(database)/documents/deda_progress_evidence/$(accountKey)/captures/$(d.records.progressCaptureId)).data;
      return captureId.matches('^[A-Za-z0-9_-]{20,80}$')
        && d.keys().hasAll(['format','kind','accountKey','sourceUid','installId','captureId','records','createdAt'])
        && d.keys().hasOnly(['format','kind','accountKey','sourceUid','installId','captureId','records','createdAt'])
        && d.format == 1 && d.kind == 'legacy-purchase-evidence' && d.accountKey == accountKey
        && d.sourceUid == request.auth.uid && d.captureId == captureId
        && d.installId is string && d.installId.size() > 0 && d.installId.size() <= 128
        && d.installId == get(/databases/$(database)/documents/deda_sessions/$(request.auth.uid)).data.installId
        && d.createdAt == request.time && d.records is map
        && d.records.keys().hasAll(['originalId','progressCaptureId','localSnapshot'])
        && d.records.keys().hasOnly(['originalId','progressCaptureId','localSnapshot'])
        && d.records.originalId is string && d.records.progressCaptureId is string
        && d.records.progressCaptureId.matches('^[A-Za-z0-9_-]{20,80}$')
        && d.records.localSnapshot is string && d.records.localSnapshot.size() <= 200000
        && p.format == 1 && p.kind == 'legacy-local-evidence' && p.accountKey == accountKey
        && p.captureId == d.records.progressCaptureId && p.sourceUid == d.sourceUid && p.installId == d.installId
        && ownsPurchaseOriginal(accountKey, d.records.originalId);
    }
    function validFreeCardChoice(accountKey, originalId) {
      let d = request.resource.data;
      return d.keys().hasAll(['format','accountKey','originalId','version','choice','mutationId','sourceUid','updatedAt'])
        && d.keys().hasOnly(['format','accountKey','originalId','version','choice','mutationId','sourceUid','updatedAt'])
        && d.format == 1 && d.accountKey == accountKey && d.originalId == originalId
        && d.version is int && d.version >= 1 && d.version <= 9007199254740990
        && d.choice in ['gold','diamond','royal','pink']
        && d.mutationId is string && d.mutationId.matches('^[a-f0-9]{48}$')
        && d.sourceUid == request.auth.uid && d.updatedAt == request.time;
    }
    function validPrivateData(accountKey) {
      let d = request.resource.data;
      return d.keys().hasAll(['format','accountKey','originalId','version','mutationId','payload','sourceUid','updatedAt'])
        && d.keys().hasOnly(['format','accountKey','originalId','version','mutationId','payload','sourceUid','updatedAt'])
        && d.format == 1 && d.accountKey == accountKey
        && d.originalId is string && ownsPurchaseOriginal(accountKey,d.originalId)
        && d.version is int && d.version >= 1 && d.version <= 9007199254740990
        && d.mutationId is string && d.mutationId.matches('^[a-f0-9]{48}$')
        && d.payload is string && d.payload.size() <= 200000
        && d.sourceUid == request.auth.uid && d.updatedAt == request.time;
    }
    match /deda_private_account_data/{accountKey} {
      allow get: if ownsProgressAccount(accountKey);
      allow create: if ownsProgressAccount(accountKey) && validPrivateData(accountKey)
        && request.resource.data.version == 1
        && getAfter(/databases/$(database)/documents/deda_private_account_data/$(accountKey)/versions/$(request.resource.data.mutationId)).data == request.resource.data;
      allow update: if ownsProgressAccount(accountKey) && validPrivateData(accountKey)
        && request.resource.data.originalId == resource.data.originalId
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.mutationId != resource.data.mutationId
        && getAfter(/databases/$(database)/documents/deda_private_account_data/$(accountKey)/versions/$(request.resource.data.mutationId)).data == request.resource.data;
      allow list, delete: if false;
      match /versions/{mutationId} {
        allow get: if ownsProgressAccount(accountKey);
        allow create: if ownsProgressAccount(accountKey) && validPrivateData(accountKey)
          && mutationId == request.resource.data.mutationId
          && getAfter(/databases/$(database)/documents/deda_private_account_data/$(accountKey)).data == request.resource.data;
        allow list, update, delete: if false;
      }
    }
    match /deda_free_card_choices/{accountKey}/cards/{originalId} {
      allow get: if ownsProgressAccount(accountKey) && ownsPurchaseOriginal(accountKey,originalId);
      allow create: if ownsProgressAccount(accountKey) && ownsPurchaseOriginal(accountKey,originalId)
        && validFreeCardChoice(accountKey,originalId) && request.resource.data.version == 1;
      allow update: if ownsProgressAccount(accountKey) && ownsPurchaseOriginal(accountKey,originalId)
        && validFreeCardChoice(accountKey,originalId)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.mutationId != resource.data.mutationId;
      allow list, delete: if false;
    }
    match /deda_purchase_evidence/{accountKey}/captures/{captureId} {
      allow get, list: if ownsProgressAccount(accountKey);
      allow create: if ownsProgressAccount(accountKey) && validPurchaseEvidence(accountKey,captureId);
      allow update, delete: if false;
    }
    match /deda_progress_evidence/{accountKey}/captures/{captureId} {
      allow get, list: if ownsProgressAccount(accountKey);
      allow create: if ownsProgressAccount(accountKey) && validEvidence(accountKey,captureId);
      allow update, delete: if false;
    }
    // Verified receipts and projections can only be written by a separate
    // trusted server authority. Raw legacy archives never grant that authority.
    match /deda_progress_receipts/{accountKey}/events/{eventId} {
      allow read, write: if false;
    }
    // Migration reviews, classifications and settlement evidence are private
    // trusted-worker inputs, never approval flags supplied by the phone.
    match /deda_progress_migrations/{accountKey}/{document=**} {
      allow read, write: if false;
    }
    match /deda_verified_progress/{accountKey} {
      allow get: if ownsProgressAccount(accountKey);
      allow list, write: if false;
      match /events/{eventId} {
        allow get, list: if ownsProgressAccount(accountKey);
        allow write: if false;
      }
    }
    match /deda_sessions/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // The native archive transport reads its own user projection as a second
    // proof input. No enumeration, cross-UID read or client write is allowed.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // No UI/role/wallet/progress application or permission added here.
    match /{document=**} { allow read, write: if false; }
  }
}
