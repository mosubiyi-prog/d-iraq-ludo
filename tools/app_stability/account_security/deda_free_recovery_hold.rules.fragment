    // DEDA 100426: opt-in account identity HOLD over Spark Firestore Rules.
    // No financial restore, ID transfer, account merge or login replacement.
    // A valid *fresh PIN proof* is required; trustedInstallIds are NOT proof.
    match /deda_recovery_identity_holds/{uid} {
      allow list, update, delete: if false;
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'accountKey', 'originalId', 'sourceUid',
          'status', 'canRestoreAssets', 'canMigrate',
          'canCreditXp', 'canCreditDiamonds', 'canIssueGift', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'accountKey', 'originalId', 'sourceUid',
          'status', 'canRestoreAssets', 'canMigrate',
          'canCreditXp', 'canCreditDiamonds', 'canIssueGift', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'PIN_PROVED_HOLD'
        && request.resource.data.createdAt == request.time
        && request.resource.data.canRestoreAssets == false
        && request.resource.data.canMigrate == false
        && request.resource.data.canCreditXp == false
        && request.resource.data.canCreditDiamonds == false
        && request.resource.data.canIssueGift == false
        && request.resource.data.accountKey is string
        && request.resource.data.accountKey.matches('^[0-9]{8,15}$')
        && request.resource.data.originalId is string
        && request.resource.data.originalId.matches('^@DEDA-[A-Z0-9]{6}$')
        && request.resource.data.sourceUid is string
        && request.resource.data.sourceUid.size() > 0
        && exists(/databases/$(database)/documents/deda_auth_attempts/$(uid))
        && get(/databases/$(database)/documents/deda_auth_attempts/$(uid)).data.accountKey
          == request.resource.data.accountKey
        && get(/databases/$(database)/documents/deda_auth_attempts/$(uid)).data.createdAt
          >= request.time - duration.value(5, 'm')
        && exists(/databases/$(database)/documents/deda_credentials/$(request.resource.data.accountKey))
        && get(/databases/$(database)/documents/deda_credentials/$(request.resource.data.accountKey)).data.active == true
        && get(/databases/$(database)/documents/deda_credentials/$(request.resource.data.accountKey)).data.pin
          == get(/databases/$(database)/documents/deda_auth_attempts/$(uid)).data.pin
        && exists(/databases/$(database)/documents/deda_account_directory/$(request.resource.data.accountKey))
        && get(/databases/$(database)/documents/deda_account_directory/$(request.resource.data.accountKey)).data.active == true
        && get(/databases/$(database)/documents/deda_account_directory/$(request.resource.data.accountKey)).data.createdUid
          == request.resource.data.sourceUid
        && get(/databases/$(database)/documents/deda_credentials/$(request.resource.data.accountKey)).data.createdUid
          == request.resource.data.sourceUid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.sourceUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.sourceUid)).data.accountKey
          == request.resource.data.accountKey
        && get(/databases/$(database)/documents/users/$(request.resource.data.sourceUid)).data.sharePersonalId
          == request.resource.data.originalId
        && exists(/databases/$(database)/documents/deda_share_ids/$(request.resource.data.originalId))
        && get(/databases/$(database)/documents/deda_share_ids/$(request.resource.data.originalId)).data.publicId
          == request.resource.data.originalId
        && get(/databases/$(database)/documents/deda_share_ids/$(request.resource.data.originalId)).data.kind
          == 'personal'
        && get(/databases/$(database)/documents/deda_share_ids/$(request.resource.data.originalId)).data.active
          == true
        && get(/databases/$(database)/documents/deda_share_ids/$(request.resource.data.originalId)).data.ownerUid
          == request.resource.data.sourceUid;
    }

