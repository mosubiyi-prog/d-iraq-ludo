rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminData().active == true
        && (
          !adminData().keys().hasAny(['status'])
          || adminData().status == 'active'
        );
    }

    function isGeneralManager() {
      return isAdmin()
        && (
          !adminData().keys().hasAny(['role'])
          || adminData().role in [
            'general_manager', 'manager', 'director', 'admin'
          ]
        );
    }

    function isProvinceAgent() {
      return isAdmin()
        && adminData().keys().hasAny(['role'])
        && adminData().role == 'province_agent';
    }

    function hasAdminPermission(permission) {
      return isGeneralManager()
        || (
          isAdmin()
          && adminData().keys().hasAny(['permissions'])
          && adminData().permissions is map
          && adminData().permissions.keys().hasAny([permission])
          && adminData().permissions[permission] == true
        );
    }

    function adminCanReadCreatedAfterActivation(data) {
      return isGeneralManager()
        || (
          isAdmin()
          && adminData().keys().hasAny(['firstLoginCompletedAt'])
          && adminData().firstLoginCompletedAt is timestamp
          && data.keys().hasAny(['createdAt'])
          && data.createdAt is timestamp
          && data.createdAt >= adminData().firstLoginCompletedAt
        );
    }

    function validAdminRole(role) {
      return role in [
        'general_manager', 'deputy_manager', 'employee', 'province_agent'
      ];
    }

    function validAdminStatus(status) {
      return status in ['active', 'temporarily_stopped', 'disabled'];
    }

    function inviteData(inviteId) {
      return get(
        /databases/$(database)/documents/admin_invites/$(inviteId)
      ).data;
    }

    function adminProvinceMatches(data) {
      return !isProvinceAgent()
        || (
          adminData().keys().hasAny(['governorate'])
          && data.keys().hasAny(['governorate'])
          && adminData().governorate == data.governorate
        );
    }

    function canReadSupport() {
      return hasAdminPermission('supportRead') && !isProvinceAgent();
    }

    function canReplySupport() {
      return hasAdminPermission('supportReply') && !isProvinceAgent();
    }

    function canReadUsers() {
      return hasAdminPermission('viewUsers') && !isProvinceAgent();
    }

    function hasDedaSession(accountKey) {
      return signedIn()
        && accountKey is string
        && exists(/databases/$(database)/documents/deda_sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/deda_sessions/$(request.auth.uid)).data.accountKey == accountKey;
    }

    function sameAccount(accountKey) {
      return signedIn()
        && accountKey is string
        && (
          hasDedaSession(accountKey)
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountKey == accountKey
          )
        );
    }

    function currentUserHasShareId(publicId) {
      return signedIn()
        && publicId is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['sharePersonalId'])
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sharePersonalId == publicId
          )
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['sharePlaceId'])
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sharePlaceId == publicId
          )
        );
    }

    match /admin_invites/{inviteId} {
      allow read: if isGeneralManager()
        || (
          signedIn()
          && resource.data.keys().hasAny(['claimedUid'])
          && resource.data.claimedUid == request.auth.uid
          && resource.data.status in ['claimed', 'completed']
        );

      allow create: if isGeneralManager()
        && request.resource.data.status == 'pending'
        && request.resource.data.adminId is string
        && request.resource.data.adminId.size() > 0
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.phone is string
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && validAdminRole(request.resource.data.role)
        && request.resource.data.governorate is string
        && (
          request.resource.data.role != 'province_agent'
          || request.resource.data.governorate.size() > 0
        )
        && request.resource.data.permissions is map
        && request.resource.data.activationCode is string
        && request.resource.data.activationCode.matches('^[0-9]{8}$')
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <=
          request.time + duration.value(8, 'd')
        && request.resource.data.keys().hasOnly([
          'adminId', 'displayName', 'email', 'phone', 'department',
          'role', 'governorate', 'permissions', 'status', 'activationCode',
          'createdByUid', 'createdByName', 'createdAt', 'updatedAt',
          'expiresAt'
        ]);

      allow update: if isGeneralManager()
        || (
          signedIn()
          && resource.data.status == 'pending'
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt > request.time
          && request.auth.token.email == resource.data.email
          && request.resource.data.status == 'claimed'
          && request.resource.data.claimedUid == request.auth.uid
          && request.resource.data.claimCode == resource.data.activationCode
          && request.resource.data.claimedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'claimedUid', 'claimCode', 'claimedAt', 'updatedAt'
          ])
        )
        || (
          signedIn()
          && resource.data.status == 'claimed'
          && resource.data.claimedUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && !request.resource.data.keys().hasAny([
            'claimedUid', 'claimCode', 'claimedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'claimedUid', 'claimCode', 'claimedAt', 'updatedAt'
          ])
        )
        || (
          signedIn()
          && resource.data.status == 'claimed'
          && resource.data.claimedUid == request.auth.uid
          && request.resource.data.status == 'completed'
          && request.resource.data.claimedUid == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.updatedAt == request.time
          && !request.resource.data.keys().hasAny([
            'activationCode', 'claimCode'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedAt', 'updatedAt',
            'activationCode', 'claimCode'
          ])
        );

      allow delete: if isGeneralManager();
    }

    // DEDA administration-entry phone gateway v2.
    // A DEDA account may read only its own gateway document. Only an active
    // general manager may list or manage the complete registry.
    match /admin_entry_access/{accountKey} {
      allow get: if sameAccount(accountKey)
        || isGeneralManager()
        || (
          isAdmin()
          && resource.data.accountKey == accountKey
          && resource.data.accessType == 'member'
          && resource.data.allowedRole == adminData().role
          && (
            (
              resource.data.keys().hasAny(['adminUid'])
              && resource.data.adminUid == request.auth.uid
            )
            || (
              resource.data.keys().hasAny(['allowedAdminEmail'])
              && resource.data.allowedAdminEmail == request.auth.token.email
            )
          )
        );
      allow list: if isGeneralManager();

      allow create: if isGeneralManager()
        && request.resource.data.accountKey == accountKey
        && request.resource.data.active == true
        && request.resource.data.status in ['active', 'invited']
        && request.resource.data.accessType in [
          'general_manager_gateway', 'member'
        ]
        && request.resource.data.allowedRole is string
        && validAdminRole(request.resource.data.allowedRole)
        && request.resource.data.managedByUid == request.auth.uid
        && (
          (
            request.resource.data.accessType == 'general_manager_gateway'
            && request.resource.data.allowedRole == 'general_manager'
            && request.resource.data.status == 'active'
          )
          || (
            request.resource.data.accessType == 'member'
            && request.resource.data.allowedRole != 'general_manager'
            && request.resource.data.allowedAdminEmail is string
            && request.resource.data.allowedAdminEmail.size() > 3
          )
        );

      allow update: if isGeneralManager()
        || (
          isAdmin()
          && resource.data.accessType == 'member'
          && resource.data.accountKey == accountKey
          && resource.data.allowedAdminEmail ==
            request.auth.token.email
          && resource.data.allowedRole == adminData().role
          && request.resource.data.accountKey == resource.data.accountKey
          && request.resource.data.accessType == resource.data.accessType
          && request.resource.data.allowedAdminEmail ==
            resource.data.allowedAdminEmail
          && request.resource.data.allowedRole == resource.data.allowedRole
          && request.resource.data.adminUid == request.auth.uid
          && request.resource.data.active == true
          && request.resource.data.status == 'active'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'adminUid', 'adminId', 'status', 'active', 'updatedAt'
          ])
        );

      allow delete: if isGeneralManager();
    }

    // Password-recovery channel for administration members. The request can
    // be created only from the DEDA phone already bound to that member. Only
    // the general manager may approve or reject it. Cloud Functions use the
    // Admin SDK to issue and consume the six-digit recovery code.
    match /admin_recovery_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.status == 'new'
        && request.resource.data.accountKey is string
        && request.resource.data.phone is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.email is string
        && request.resource.data.targetAdminUid is string
        && request.resource.data.targetAdminUid.size() > 0
        && request.resource.data.targetAdminId is string
        && request.resource.data.targetRole is string
        && request.resource.data.targetRole != 'general_manager'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'requesterUid', 'accountKey', 'phone', 'fullName', 'email',
          'targetAdminUid', 'targetAdminId', 'targetRole', 'status',
          'createdAt', 'updatedAt'
        ])
        && sameAccount(request.resource.data.accountKey)
        && exists(
          /databases/$(database)/documents/admin_entry_access/$(request.resource.data.accountKey)
        )
        && get(
          /databases/$(database)/documents/admin_entry_access/$(request.resource.data.accountKey)
        ).data.active == true
        && get(
          /databases/$(database)/documents/admin_entry_access/$(request.resource.data.accountKey)
        ).data.status == 'active'
        && get(
          /databases/$(database)/documents/admin_entry_access/$(request.resource.data.accountKey)
        ).data.accessType == 'member'
        && get(
          /databases/$(database)/documents/admin_entry_access/$(request.resource.data.accountKey)
        ).data.allowedAdminEmail == request.resource.data.email
        && get(
          /databases/$(database)/documents/admin_entry_access/$(request.resource.data.accountKey)
        ).data.adminUid == request.resource.data.targetAdminUid
        && get(
          /databases/$(database)/documents/admin_entry_access/$(request.resource.data.accountKey)
        ).data.allowedRole == request.resource.data.targetRole;

      allow read: if isGeneralManager()
        || (
          signedIn()
          && resource.data.accountKey is string
          && sameAccount(resource.data.accountKey)
        );

      allow update: if (
        isGeneralManager()
        && resource.data.status == 'new'
        && request.resource.data.status in ['ready', 'rejected']
        && request.resource.data.decisionByUid == request.auth.uid
        && request.resource.data.decisionByName is string
        && request.resource.data.decisionAt == request.time
        && request.resource.data.rejectionReason is string
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'rejected'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'decisionByUid', 'decisionByName', 'decisionAt',
              'rejectionReason', 'updatedAt'
            ])
          )
          || (
            request.resource.data.status == 'ready'
            && request.resource.data.recoveryPin is string
            && request.resource.data.recoveryPin.size() == 6
            && request.resource.data.recoveryPinIssuedAt == request.time
            && request.resource.data.recoveryPinExpiresAt is timestamp
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'decisionByUid', 'decisionByName', 'decisionAt',
              'rejectionReason', 'recoveryPin', 'recoveryPinIssuedAt',
              'recoveryPinExpiresAt', 'updatedAt'
            ])
          )
        )
      ) || (
        signedIn()
        && resource.data.status == 'ready'
        && resource.data.accountKey is string
        && sameAccount(resource.data.accountKey)
        && request.resource.data.status == 'reset_link_sent'
        && request.resource.data.resetLinkSentAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resetLinkSentAt', 'updatedAt'
        ])
      );

      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid)
        || isGeneralManager();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.inviteId is string
        && exists(
          /databases/$(database)/documents/admin_invites/$(request.resource.data.inviteId)
        )
        && inviteData(request.resource.data.inviteId).status == 'claimed'
        && inviteData(request.resource.data.inviteId).claimedUid == uid
        && request.auth.token.email == inviteData(request.resource.data.inviteId).email
        && request.resource.data.adminId ==
          inviteData(request.resource.data.inviteId).adminId
        && request.resource.data.displayName ==
          inviteData(request.resource.data.inviteId).displayName
        && request.resource.data.email ==
          inviteData(request.resource.data.inviteId).email
        && request.resource.data.phone ==
          inviteData(request.resource.data.inviteId).phone
        && request.resource.data.department ==
          inviteData(request.resource.data.inviteId).department
        && request.resource.data.role ==
          inviteData(request.resource.data.inviteId).role
        && request.resource.data.governorate ==
          inviteData(request.resource.data.inviteId).governorate
        && request.resource.data.permissions ==
          inviteData(request.resource.data.inviteId).permissions
        && request.resource.data.createdByUid ==
          inviteData(request.resource.data.inviteId).createdByUid
        && request.resource.data.createdByName ==
          inviteData(request.resource.data.inviteId).createdByName
        && request.resource.data.permissionsUpdatedByUid ==
          inviteData(request.resource.data.inviteId).createdByUid
        && request.resource.data.permissionsUpdatedByName ==
          inviteData(request.resource.data.inviteId).createdByName
        && validAdminRole(request.resource.data.role)
        && request.resource.data.status == 'active'
        && request.resource.data.active == true
        && request.resource.data.mustChangePassword == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.permissionsUpdatedAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.lastLoginAt == request.time
        && request.resource.data.firstLoginCompletedAt == request.time
        && request.resource.data.keys().hasOnly([
          'adminId', 'displayName', 'email', 'phone', 'department',
          'role', 'governorate', 'status', 'active', 'permissions',
          'mustChangePassword', 'inviteId', 'createdAt', 'updatedAt',
          'createdByUid', 'createdByName',
          'permissionsUpdatedAt', 'permissionsUpdatedByUid',
          'permissionsUpdatedByName', 'lastSeenAt', 'lastLoginAt',
          'firstLoginCompletedAt'
        ]);

      allow update: if (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fcmTokens', 'lastSeenAt', 'lastLoginAt',
            'displayName', 'updatedAt'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'displayName'
            ])
            || (
              request.resource.data.displayName is string
              && request.resource.data.displayName.size() >= 2
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'updatedAt'
            ])
            || request.resource.data.updatedAt == request.time
          )
        )
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.mustChangePassword == true
          && request.resource.data.mustChangePassword == false
          && request.resource.data.firstLoginCompletedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'mustChangePassword', 'firstLoginCompletedAt', 'updatedAt'
          ])
        )
        || (
          isGeneralManager()
          && request.auth.uid != uid
          && request.resource.data.status == 'temporarily_stopped'
          && request.resource.data.active == false
          && request.resource.data.updatedAt == request.time
          && request.resource.data.statusUpdatedAt == request.time
          && request.resource.data.statusUpdatedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'active', 'updatedAt', 'statusReason',
            'statusUpdatedAt', 'statusUpdatedByUid', 'statusUpdatedByName'
          ])
        )
        || (
          isGeneralManager()
          && validAdminRole(request.resource.data.role)
          && validAdminStatus(request.resource.data.status)
          && request.resource.data.active ==
            (request.resource.data.status == 'active')
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.department is string
          && request.resource.data.department.size() > 0
          && request.resource.data.permissions is map
          && (
            request.resource.data.role != 'province_agent'
            || (
              request.resource.data.governorate is string
              && request.resource.data.governorate.size() > 0
            )
          )
          && (
            request.auth.uid != uid
            || (
              request.resource.data.role == resource.data.role
              && request.resource.data.status == resource.data.status
              && request.resource.data.active == resource.data.active
            )
          )
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.permissionsUpdatedAt == request.time
          && request.resource.data.permissionsUpdatedByUid == request.auth.uid
          && request.resource.data.statusUpdatedAt == request.time
          && request.resource.data.statusUpdatedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'phone', 'department', 'role', 'governorate',
            'status', 'active', 'permissions', 'updatedAt',
            'updatedByUid', 'updatedByName',
            'permissionsUpdatedAt', 'permissionsUpdatedByUid',
            'permissionsUpdatedByName', 'statusReason', 'statusUpdatedAt',
            'statusUpdatedByUid', 'statusUpdatedByName'
          ])
        );

      allow delete: if isGeneralManager()
        && request.auth.uid != uid;
    }

    // DEDA free PIN authentication. The credential document is never readable
    // by an ordinary app session. Firestore rules compare a submitted PIN to it.
    match /deda_credentials/{accountKey} {
      allow get, list: if false;

      allow create: if isGeneralManager() || (
        signedIn()
        && !exists(/databases/$(database)/documents/deda_account_directory/$(accountKey))
        && request.resource.data.accountKey == accountKey
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{6}$')
        && request.resource.data.active == true
        && request.resource.data.createdUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'accountKey', 'pin', 'active', 'createdUid',
          'createdAt', 'updatedAt'
        ])
      );

      allow update: if isGeneralManager();
      allow delete: if false;
    }

    match /deda_account_directory/{accountKey} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.accountKey == accountKey
        && request.resource.data.active == true
        && request.resource.data.createdUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'accountKey', 'active', 'createdUid',
          'createdAt', 'updatedAt'
        ])
        && existsAfter(/databases/$(database)/documents/deda_credentials/$(accountKey))
        && getAfter(/databases/$(database)/documents/deda_credentials/$(accountKey)).data.createdUid == request.auth.uid;

      allow update: if isGeneralManager();
      allow delete: if false;
    }

    // A correct PIN can create/update only the caller's proof document.
    // The credential itself remains unreadable to the client.
    match /deda_auth_attempts/{uid} {
      allow get, list: if false;

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.accountKey is string
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{6}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'accountKey', 'pin', 'createdAt'
        ])
        && exists(/databases/$(database)/documents/deda_credentials/$(request.resource.data.accountKey))
        && get(/databases/$(database)/documents/deda_credentials/$(request.resource.data.accountKey)).data.active == true
        && get(/databases/$(database)/documents/deda_credentials/$(request.resource.data.accountKey)).data.pin == request.resource.data.pin;

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /deda_sessions/{uid} {
      allow read: if isGeneralManager() || (signedIn() && request.auth.uid == uid);

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.accountKey is string
        && request.resource.data.installId is string
        && request.resource.data.keys().hasOnly([
          'uid', 'accountKey', 'installId', 'signedInAt', 'lastSeenAt'
        ])
        && (
          (
            exists(/databases/$(database)/documents/deda_auth_attempts/$(uid))
            && get(/databases/$(database)/documents/deda_auth_attempts/$(uid)).data.accountKey
              == request.resource.data.accountKey
            && exists(/databases/$(database)/documents/deda_credentials/$(request.resource.data.accountKey))
            && get(/databases/$(database)/documents/deda_auth_attempts/$(uid)).data.pin
              == get(/databases/$(database)/documents/deda_credentials/$(request.resource.data.accountKey)).data.pin
          )
          || (
            exists(/databases/$(database)/documents/deda_account_profiles/$(request.resource.data.accountKey))
            && get(/databases/$(database)/documents/deda_account_profiles/$(request.resource.data.accountKey)).data.trustedInstallIds is list
            && request.resource.data.installId
              in get(/databases/$(database)/documents/deda_account_profiles/$(request.resource.data.accountKey)).data.trustedInstallIds
          )
        );

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /deda_account_profiles/{accountKey} {
      allow get: if isGeneralManager() || hasDedaSession(accountKey);
      allow list: if isGeneralManager();

      allow create: if isGeneralManager() || (
        hasDedaSession(accountKey)
        && request.resource.data.accountKey == accountKey
        && request.resource.data.keys().hasOnly([
          'accountKey', 'name', 'phone', 'accountType',
          'trustedInstallIds', 'createdAt', 'updatedAt', 'lastSeenAt'
        ])
      );

      allow update: if isGeneralManager() || (
        hasDedaSession(accountKey)
        && request.resource.data.accountKey == accountKey
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'accountType', 'trustedInstallIds',
          'updatedAt', 'lastSeenAt'
        ])
      );

      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if canReadUsers()
        || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.accountKey is string
        && hasDedaSession(request.resource.data.accountKey)
        && request.resource.data.keys().hasOnly([
          'fcmTokens', 'lastSeenAt', 'name', 'phone', 'accountType',
          'accountKey', 'createdAt', 'updatedAt', 'authMethod',
          'trustedInstallIds', 'sharePersonalId', 'sharePlaceId'
        ]);

      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.accountKey is string
        && hasDedaSession(resource.data.accountKey)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fcmTokens', 'lastSeenAt', 'name', 'phone', 'accountType',
          'accountKey', 'createdAt', 'updatedAt', 'authMethod',
          'trustedInstallIds', 'sharePersonalId', 'sharePlaceId'
        ]);

      allow delete: if false;
    }

    match /deda_share_ids/{publicId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.publicId == publicId
        && request.resource.data.ownerUid == request.auth.uid
        && currentUserHasShareId(publicId)
        && request.resource.data.kind in ['personal', 'place']
        && request.resource.data.displayName is string
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'publicId', 'kind', 'displayName', 'ownerUid', 'active',
          'createdAt', 'updatedAt'
        ]);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && currentUserHasShareId(publicId)
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'active', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /deda_location_shares/{shareId} {
      allow read: if signedIn()
        && (
          resource.data.senderUid == request.auth.uid
          || currentUserHasShareId(resource.data.recipientPublicId)
        );

      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && currentUserHasShareId(request.resource.data.senderPublicId)
        && request.resource.data.recipientPublicId is string
        && exists(
          /databases/$(database)/documents/deda_share_ids/$(request.resource.data.recipientPublicId)
        )
        && get(
          /databases/$(database)/documents/deda_share_ids/$(request.resource.data.recipientPublicId)
        ).data.active == true
        && get(
          /databases/$(database)/documents/deda_share_ids/$(request.resource.data.recipientPublicId)
        ).data.kind == 'personal'
        && request.resource.data.shareType in ['current', 'place']
        && request.resource.data.placeId is string
        && (
          (
            request.resource.data.shareType == 'current'
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sharePersonalId
              == request.resource.data.senderPublicId
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
              == request.resource.data.senderName
            && request.resource.data.placeId == ''
            && request.resource.data.placeName == ''
          )
          || (
            request.resource.data.shareType == 'place'
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sharePlaceId
              == request.resource.data.senderPublicId
            && request.resource.data.placeId.size() > 0
            && exists(
              /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
            )
            && get(
              /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
            ).data.published == true
            && (
              get(
                /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
              ).data.ownerUid == request.auth.uid
              || sameAccount(
                get(
                  /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
                ).data.accountKey
              )
            )
            && get(
              /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
            ).data.placeName == request.resource.data.placeName
            && request.resource.data.senderName == request.resource.data.placeName
            && get(
              /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
            ).data.latitude == request.resource.data.latitude
            && get(
              /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
            ).data.longitude == request.resource.data.longitude
          )
        )
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.durationMinutes in [15, 30, 60]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <=
          request.time + duration.value(61, 'm')
        && request.resource.data.senderName is string
        && request.resource.data.placeName is string
        && request.resource.data.keys().hasOnly([
          'senderUid', 'senderPublicId', 'senderName',
          'recipientPublicId', 'shareType', 'placeName', 'placeId',
          'latitude', 'longitude', 'durationMinutes', 'status',
          'createdAt', 'updatedAt', 'expiresAt'
        ]);

      allow update: if signedIn()
        && currentUserHasShareId(resource.data.recipientPublicId)
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && resource.data.status in ['pending', 'accepted']
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.readAt == request.time
        && (
          (
            request.resource.data.status == 'accepted'
            && request.resource.data.acceptedAt == request.time
          )
          || (
            request.resource.data.status == 'rejected'
            && request.resource.data.rejectedAt == request.time
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'readAt', 'acceptedAt', 'rejectedAt'
        ]);

      allow delete: if false;
    }

    match /owner_place_notifications/{notificationId} {
      allow read: if isGeneralManager()
        || (
          signedIn()
          && (
            resource.data.ownerUid == request.auth.uid
            || sameAccount(resource.data.accountKey)
          )
        );

      allow create: if isAdmin()
        && adminProvinceMatches(request.resource.data)
        && request.resource.data.type in [
          'deletion_approved', 'deletion_rejected', 'needs_changes',
          'edit_approved', 'place_report', 'admin_alert', 'custom'
        ]
        && request.resource.data.accountKey is string
        && request.resource.data.accountKey.size() > 0
        && request.resource.data.ownerUid is string
        && request.resource.data.placeId is string
        && request.resource.data.placeName is string
        && request.resource.data.approvalNumber is string
        && request.resource.data.governorate is string
        && request.resource.data.titleAr is string
        && request.resource.data.titleAr.size() > 0
        && request.resource.data.titleEn is string
        && request.resource.data.titleEn.size() > 0
        && request.resource.data.bodyAr is string
        && request.resource.data.bodyAr.size() > 0
        && request.resource.data.bodyEn is string
        && request.resource.data.bodyEn.size() > 0
        && request.resource.data.sourceType is string
        && request.resource.data.sourceId is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByRole is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'type', 'accountKey', 'ownerUid', 'placeId', 'placeName',
          'approvalNumber', 'governorate', 'titleAr', 'titleEn',
          'bodyAr', 'bodyEn', 'sourceType', 'sourceId',
          'createdByUid', 'createdByName', 'createdByRole', 'createdAt'
        ]);

      allow update: if signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || sameAccount(resource.data.accountKey)
        )
        && request.resource.data.readAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readAt'
        ]);

      allow delete: if false;
    }

    match /place_deletion_requests/{requestId} {
      allow create: if signedIn()
        && requestId == request.resource.data.placeId
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.accountKey is string
        && request.resource.data.placeId is string
        && request.resource.data.placeName is string
        && request.resource.data.approvalNumber is string
        && request.resource.data.governorate is string
        && request.resource.data.address is string
        && request.resource.data.phone is string
        && (
          !request.resource.data.keys().hasAny(['latitude'])
          || request.resource.data.latitude is number
        )
        && (
          !request.resource.data.keys().hasAny(['longitude'])
          || request.resource.data.longitude is number
        )
        && request.resource.data.reason is string
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(
          /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
        )
        && (
          isGeneralManager()
          || get(
            /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
          ).data.ownerUid == request.auth.uid
          || sameAccount(
            get(
              /databases/$(database)/documents/published_places/$(request.resource.data.placeId)
            ).data.accountKey
          )
        )
        && request.resource.data.keys().hasOnly([
          'requesterUid', 'accountKey', 'placeId', 'placeName',
          'approvalNumber', 'governorate', 'address', 'phone',
          'latitude', 'longitude', 'reason', 'status',
          'createdAt', 'updatedAt'
        ]);

      // The request document uses the place ID as its ID. On the very
      // first submission the request does not exist yet, so let the verified
      // owner read that missing ID through ownership of the published place.
      // This keeps the first tap idempotent instead of failing on the
      // pre-create existence check.
      allow get: if isGeneralManager()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/place_deletion_requests/$(requestId)
          )
          && (
            resource.data.requesterUid == request.auth.uid
            || sameAccount(resource.data.accountKey)
          )
        )
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/published_places/$(requestId)
          )
          && (
            get(
              /databases/$(database)/documents/published_places/$(requestId)
            ).data.ownerUid == request.auth.uid
            || sameAccount(
              get(
                /databases/$(database)/documents/published_places/$(requestId)
              ).data.accountKey
            )
          )
        );

      allow list: if isGeneralManager()
        || (
          signedIn()
          && resource != null
          && (
            resource.data.requesterUid == request.auth.uid
            || sameAccount(resource.data.accountKey)
          )
        );

      allow update: if (
          isGeneralManager()
          && request.resource.data.status in [
            'reviewing', 'deleted', 'rejected', 'cancelled'
          ]
          && request.resource.data.updatedAt == request.time
          && request.resource.data.reviewedByUid == request.auth.uid
          && request.resource.data.reviewedByName is string
          && request.resource.data.reviewedByRole is string
          && request.resource.data.reviewNote is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'reviewedByUid', 'reviewedByName',
            'reviewedByRole', 'reviewNote', 'completedAt', 'closedAt'
          ])
        )
        || (
          isGeneralManager()
          && resource.data.status in ['rejected', 'cancelled', 'pending']
          && request.resource.data.status == 'new'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.resubmittedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reason', 'updatedAt', 'resubmittedAt'
          ])
        )
        || (
          signedIn()
          && (
            resource.data.requesterUid == request.auth.uid
            || sameAccount(resource.data.accountKey)
          )
          && resource.data.status in ['rejected', 'cancelled', 'pending']
          && request.resource.data.status == 'new'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.resubmittedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reason', 'updatedAt', 'resubmittedAt'
          ])
        );

      allow delete: if false;
    }

    match /account_deletion_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.accountKey is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.reason is string
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'requesterUid', 'accountKey', 'name', 'phone', 'reason',
          'status', 'createdAt', 'updatedAt'
        ]);

      allow read: if isGeneralManager()
        || (
          signedIn()
          && resource.data.requesterUid == request.auth.uid
        );

      allow update: if isGeneralManager()
        && request.resource.data.status in [
          'new', 'reviewing', 'deleted', 'cancelled', 'rejected'
        ]
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.reviewedByName is string
        && request.resource.data.reviewedByRole is string
        && request.resource.data.reviewNote is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'reviewedByUid', 'reviewedByName',
          'reviewedByRole', 'reviewNote', 'completedAt', 'closedAt'
        ]);

      allow delete: if false;
    }

    match /recovery_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.accountKey is string
        && request.resource.data.phone is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.requesterInstallId is string
        && request.resource.data.keys().hasOnly([
          'requesterUid', 'requesterInstallId', 'accountKey', 'phone',
          'fullName', 'status', 'createdAt', 'updatedAt'
        ]);

      allow read: if isGeneralManager()
        || (signedIn() && resource.data.requesterUid == request.auth.uid);

      allow update: if isGeneralManager();
      allow delete: if false;
    }

    // Retained as a denied legacy path so older test builds cannot expose
    // recovery secrets. Build 95 reads the approved code from its own request.
    match /recovery_secrets/{requestId} {
      allow read, write: if false;
    }

    // Final DEDA points-card prize request. One deterministic request is
    // allowed per account for this prize cycle. The client card flow supplies
    // the stage record; administration remains responsible for final review.
    match /prize_winner_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.accountKey is string
        && request.resource.data.cycleId == 'prize_v1'
        && sameAccount(request.resource.data.accountKey)
        && requestId == 'prize_v1_' + request.resource.data.accountKey
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.dedaId is string
        && request.resource.data.dedaId.size() > 0
        && request.resource.data.rewardCode is string
        && request.resource.data.rewardCode.size() == 16
        && request.resource.data.pointsAtCompletion is int
        && request.resource.data.pointsAtCompletion >= 0
        && request.resource.data.completedThresholds == [
          5000, 10000, 15000, 20000, 25000
        ]
        && request.resource.data.finalReservedPoints == 25000
        && request.resource.data.status == 'new'
        && request.resource.data.adminMessage == ''
        && request.resource.data.prizeDetails == ''
        && request.resource.data.userReply == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'cycleId', 'accountKey', 'name', 'phone', 'dedaId',
          'rewardCode', 'pointsAtCompletion', 'completedThresholds',
          'finalReservedPoints', 'status', 'adminMessage', 'prizeDetails',
          'userReply', 'createdAt', 'updatedAt'
        ]);

      // Exact gets for a not-yet-created request are allowed to signed-in
      // users so submission can be idempotent. Existing winner records remain
      // visible only to their owner/account or to the general manager.
      allow get: if isGeneralManager()
        || (
          signedIn()
          && (
            !exists(
              /databases/$(database)/documents/prize_winner_requests/$(requestId)
            )
            || resource.data.ownerUid == request.auth.uid
            || sameAccount(resource.data.accountKey)
          )
        );
      allow list: if isGeneralManager();

      allow update: if (
          isGeneralManager()
          && request.resource.data.status in [
            'new', 'reviewing', 'needs_info', 'approved',
            'prize_sent', 'rejected'
          ]
          && (
            request.resource.data.status != 'prize_sent'
            || (
              request.resource.data.prizeDetails is string
              && request.resource.data.prizeDetails.size() > 0
            )
          )
          && request.resource.data.adminByUid == request.auth.uid
          && request.resource.data.adminByName is string
          && request.resource.data.adminByRole == 'general_manager'
          && request.resource.data.adminUpdatedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'adminMessage', 'prizeDetails',
            'adminByUid', 'adminByName', 'adminByRole',
            'adminUpdatedAt', 'updatedAt', 'prizeSentAt'
          ])
        )
        || (
          signedIn()
          && resource.data.status == 'needs_info'
          && (
            resource.data.ownerUid == request.auth.uid
            || sameAccount(resource.data.accountKey)
          )
          && request.resource.data.status == 'reviewing'
          && request.resource.data.userReply is string
          && request.resource.data.userReply.size() > 0
          && request.resource.data.userReplyAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'userReply', 'userReplyAt', 'updatedAt'
          ])
        )
        || (
          signedIn()
          && resource.data.status == 'prize_sent'
          && (
            resource.data.ownerUid == request.auth.uid
            || sameAccount(resource.data.accountKey)
          )
          && request.resource.data.status == 'delivered'
          && request.resource.data.winnerConfirmedAt == request.time
          && request.resource.data.deliveredAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'winnerConfirmedAt', 'deliveredAt', 'updatedAt'
          ])
        );

      allow delete: if false;
    }

    match /support_requests/{requestId} {
      allow create: if isGeneralManager()
        || (
          signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'new'
          && request.resource.data.type in ['company', 'problem', 'case', 'photo']
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 5
        );

      allow read: if (
          canReadSupport()
          && adminCanReadCreatedAfterActivation(resource.data)
        )
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || sameAccount(resource.data.accountKey);

      allow update: if (
          canReplySupport()
          && adminCanReadCreatedAfterActivation(resource.data)
          && request.resource.data.status in [
            'new', 'in_progress', 'replied', 'closed'
          ]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'reviewedBy', 'reviewedByName',
            'reviewedByRole', 'closedAt', 'adminReply', 'adminReplyAt',
            'adminReplyByUid', 'adminReplyByName', 'adminReplyByRole',
            'firstViewedAt', 'firstViewedByUid', 'firstViewedByName',
            'firstViewedByRole', 'lastViewedAt', 'lastViewedByUid',
            'lastViewedByName', 'lastViewedByRole',
            'accountReviewedAt', 'accountReviewedByUid',
            'accountReviewedByName', 'accountReviewedByRole'
          ])
        )
        || (
          canReadSupport()
          && adminCanReadCreatedAfterActivation(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstViewedAt', 'firstViewedByUid', 'firstViewedByName',
            'firstViewedByRole', 'lastViewedAt', 'lastViewedByUid',
            'lastViewedByName', 'lastViewedByRole',
            'accountReviewedAt', 'accountReviewedByUid',
            'accountReviewedByName', 'accountReviewedByRole'
          ])
        );
      allow delete: if isGeneralManager();
    }

    match /admin_trash_support/{trashId} {
      allow read, create, update, delete: if isGeneralManager();
    }

    match /admin_trash_place_requests/{trashId} {
      allow read, create, update, delete: if isGeneralManager();
    }

    match /place_requests/{requestId} {
      allow create: if isGeneralManager()
        || (
          signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.accountKey is string
        && sameAccount(request.resource.data.accountKey)
        && request.resource.data.status == 'pending'
        && request.resource.data.placeName is string
        && request.resource.data.placeName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.governorate is string
        && request.resource.data.governorate.size() > 0
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.openingHours is string
        && request.resource.data.openingHours.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && (request.resource.data.category != 'other'
          || (request.resource.data.otherCategoryText is string
            && request.resource.data.otherCategoryText.size() > 0))
        && (request.resource.data.requestType != 'update'
          || (request.resource.data.originalPlaceId is string
            && exists(/databases/$(database)/documents/published_places/$(request.resource.data.originalPlaceId))
            && (
              get(/databases/$(database)/documents/published_places/$(request.resource.data.originalPlaceId)).data.ownerUid == request.auth.uid
              || sameAccount(get(/databases/$(database)/documents/published_places/$(request.resource.data.originalPlaceId)).data.accountKey)
            )))
        );

      allow read: if (
          hasAdminPermission('viewPlaceRequests')
          && adminProvinceMatches(resource.data)
          && (
            isProvinceAgent()
            || adminCanReadCreatedAfterActivation(resource.data)
          )
        )
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || sameAccount(resource.data.accountKey);

      allow update: if (
          adminProvinceMatches(resource.data)
          && adminProvinceMatches(request.resource.data)
          && adminCanReadCreatedAfterActivation(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'reviewedBy', 'reviewedByName',
            'reviewedByRole', 'decisionAction', 'decisionAt',
            'decisionByUid', 'decisionByName', 'decisionByRole',
            'decisionNote', 'approvalNumber', 'approvalDate',
            'approvalMessageDraft', 'approvalPreparedAt',
            'approvalPreparedByUid', 'approvalPreparedByName',
            'approvalMessage', 'firstViewedAt', 'firstViewedByUid',
            'firstViewedByName', 'firstViewedByRole', 'lastViewedAt',
            'lastViewedByUid', 'lastViewedByName', 'lastViewedByRole',
            'accountReviewedAt', 'accountReviewedByUid',
            'accountReviewedByName', 'accountReviewedByRole'
          ])
          && (
            (
              request.resource.data.status == 'approved'
              && hasAdminPermission('approvePlaces')
            )
            || (
              request.resource.data.status == 'rejected'
              && hasAdminPermission('rejectPlaces')
            )
            || (
              request.resource.data.status in ['reviewing', 'needs_changes']
              && hasAdminPermission('reviewPlaceRequests')
            )
            || (
              request.resource.data.status == resource.data.status
              && hasAdminPermission('approvePlaces')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'approvalNumber', 'approvalDate', 'approvalMessageDraft',
                'approvalPreparedAt', 'approvalPreparedByUid',
                'approvalPreparedByName'
              ])
            )
            || (
              request.resource.data.status == resource.data.status
              && hasAdminPermission('viewPlaceRequests')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'firstViewedAt', 'firstViewedByUid', 'firstViewedByName',
                'firstViewedByRole', 'lastViewedAt', 'lastViewedByUid',
                'lastViewedByName', 'lastViewedByRole',
                'accountReviewedAt', 'accountReviewedByUid',
                'accountReviewedByName', 'accountReviewedByRole'
              ])
            )
          )
        )
        || (
          signedIn()
          && (
            resource.data.ownerUid == request.auth.uid
            || sameAccount(resource.data.accountKey)
          )
          && resource.data.status == 'needs_changes'
          && request.resource.data.status == 'pending'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.accountKey == resource.data.accountKey
          && request.resource.data.requestType == resource.data.requestType
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.resubmittedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'placeName', 'name', 'category', 'categoryLabelAr',
            'categoryLabelEn', 'otherCategory', 'otherCategoryLabelAr',
            'otherCategoryLabelEn', 'otherCategoryText', 'phone',
            'governorate', 'address', 'openingHours', 'hours',
            'description', 'latitude', 'longitude', 'isAvailableNow',
            'submittedByName', 'status', 'updatedAt', 'resubmittedAt'
          ])
        );
      allow delete: if isGeneralManager();
    }

    match /published_places/{placeId} {
      allow read: if isGeneralManager()
        || (
          resource.data.keys().hasAny(['published'])
          && resource.data.published == true
        );

      allow create: if hasAdminPermission('approvePlaces')
        && adminProvinceMatches(request.resource.data);

      allow delete: if isGeneralManager();

      allow update: if isGeneralManager()
        || (
          hasAdminPermission('approvePlaces')
          && adminProvinceMatches(resource.data)
          && adminProvinceMatches(request.resource.data)
          && request.resource.data.published == resource.data.published
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'hiddenByManager', 'hiddenAt', 'hiddenByUid', 'hiddenByName'
          ])
        )
        || (
          signedIn()
          && (
            resource.data.ownerUid == request.auth.uid
            || sameAccount(resource.data.accountKey)
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isAvailableNow', 'updatedAt'
          ])
        );
    }

    match /admin_trash_places/{trashId} {
      allow read, create, update, delete: if isGeneralManager();
    }


    match /road_hazards/{hazardId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.type in [
          'bump', 'roadworks', 'maintenance', 'detour', 'speed_camera',
          'checkpoint', 'accident', 'congestion', 'road_object', 'flooded'
        ]
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && (request.resource.data.heading == null
          || request.resource.data.heading is number)
        && request.resource.data.status == 'active'
        && request.resource.data.confirmations == 1
        && request.resource.data.resolvedReports == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastConfirmedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <=
          request.time + duration.value(30, 'd')
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'type', 'latitude', 'longitude', 'heading',
          'status', 'confirmations', 'resolvedReports', 'createdAt',
          'updatedAt', 'lastConfirmedAt', 'expiresAt'
        ]);

      allow update: if signedIn()
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude
        && request.resource.data.status == 'active'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'confirmations', 'resolvedReports', 'lastConfirmedAt',
          'updatedAt', 'expiresAt'
        ])
        && (
          (
            request.resource.data.confirmations ==
              resource.data.confirmations + 1
            && request.resource.data.resolvedReports ==
              resource.data.resolvedReports
            && request.resource.data.lastConfirmedAt == request.time
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt <=
              request.time + duration.value(30, 'd')
          )
          ||
          (
            request.resource.data.confirmations ==
              resource.data.confirmations
            && request.resource.data.resolvedReports ==
              resource.data.resolvedReports + 1
            && request.resource.data.lastConfirmedAt ==
              resource.data.lastConfirmedAt
            && request.resource.data.expiresAt ==
              resource.data.expiresAt
          )
        );

      allow delete: if hasAdminPermission('manageReports')
        && !isProvinceAgent();
    }

    // Task administration stage 1: manager-owned, UNPUBLISHED drafts.
    // This collection is never read by current user task points/claims.
    // Do not grant any user or non-manager access, even to list drafts.
    match /admin_task_drafts/{draftId} {
      function validDraftShape(data) {
        return data.keys().hasOnly([
          'cycle', 'action', 'titleAr', 'titleEn', 'targetCount',
          'rewardUnit', 'rewardAmount', 'url', 'status', 'revision',
          'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'cycle', 'action', 'titleAr', 'titleEn', 'targetCount',
          'rewardUnit', 'rewardAmount', 'url', 'status', 'revision',
          'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.cycle in ['daily', 'weekly']
        && data.action in [
          'open_map', 'share_personal_location', 'share_registered_place',
          'open_saved_place', 'open_received_place', 'review_added_place',
          'traffic_skills', 'long_trip', 'visit_telegram'
        ]
        && data.titleAr.matches('^.{3,80}$')
        && data.titleEn is string
        && data.titleEn.size() >= 3
        && data.titleEn.size() <= 80
        && data.targetCount is int
        && data.targetCount >= 1
        && data.targetCount <= 100
        && data.rewardUnit in ['points', 'diamonds']
        && data.rewardAmount is int
        && data.rewardAmount >= 1
        && data.rewardAmount <= 5000
        && data.url is string
        && data.url.size() <= 220
        && data.status == 'draft'
        && data.revision is int
        && data.createdByUid is string
        && data.updatedByUid is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
      }

      allow get, list: if isGeneralManager();
      allow create: if isGeneralManager()
        && validDraftShape(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isGeneralManager()
        && validDraftShape(request.resource.data)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft'
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cycle', 'action', 'titleAr', 'titleEn', 'targetCount',
          'rewardUnit', 'rewardAmount', 'url', 'updatedByUid',
          'updatedAt', 'revision'
        ]);
      allow delete: if false;
    }

    // DEDA manager surveys: private UNPUBLISHED drafts only.
    // No read access for ordinary users, no submission/claim endpoint here.
    // Validate each option's type/size in rules, not only in Flutter.
    // This prevents malformed Firestore clients from bypassing UI checks.
    function validSurveyOptionList(options) {
      // Joined regex bounds every choice; list equality rejects values
      // that are coerced to strings (number, bool, null or nested objects).
      return options is list
        && options.size() >= 2
        && options.size() <= 5
        && options.join('|').matches('^[^|\\n]{1,70}(\\|[^|\\n]{1,70}){1,4}$')
        && options == options.join('|').split('|');
    }

        function validSurveyQuestion(question) {
      return question is map
        && question.keys().size() == 6
        && question.type in ['rating_5', 'choice', 'text']
        && question.promptAr.matches('^.{3,160}$')
        && question.promptEn == question.promptAr
        && question.required is bool
        && (
          (question.type == 'choice'
            && validSurveyOptionList(question.optionsAr)
            && question.optionsEn == question.optionsAr)
          || (question.type != 'choice'
            && question.optionsAr == []
            && question.optionsEn == question.optionsAr)
        );
    }

    function validSurveyQuestions(questions) {
      return questions is list
        && questions.size() >= 1
        && questions.size() <= 6
        && validSurveyQuestion(questions[0])
        && (
          (questions.size() == 6
            && validSurveyQuestion(questions[1])
            && validSurveyQuestion(questions[2])
            && validSurveyQuestion(questions[3])
            && validSurveyQuestion(questions[4])
            && validSurveyQuestion(questions[5]))
          || (questions.size() == 5
            && validSurveyQuestion(questions[1])
            && validSurveyQuestion(questions[2])
            && validSurveyQuestion(questions[3])
            && validSurveyQuestion(questions[4]))
          || (questions.size() == 4
            && validSurveyQuestion(questions[1])
            && validSurveyQuestion(questions[2])
            && validSurveyQuestion(questions[3]))
          || (questions.size() == 3
            && validSurveyQuestion(questions[1])
            && validSurveyQuestion(questions[2]))
          || (questions.size() == 2
            && validSurveyQuestion(questions[1]))
          || questions.size() == 1
        );
    }

        function validAdminSurveyDraft(data) {
      return data.keys().size() == 13
        && data.titleAr is string
        && data.titleAr.size() >= 3
        && data.titleAr.size() <= 80
        && data.titleEn == data.titleAr
        && validSurveyQuestions(data.questions)
        && data.rewardUnit in ['none', 'coins', 'points', 'diamonds']
        && data.rewardAmount is int
        && data.rewardAmount >= 0
        && data.rewardAmount <= 1000000
        && (
          (data.rewardUnit == 'none' && data.rewardAmount == 0)
          || (data.rewardUnit != 'none' && data.rewardAmount >= 1)
        )
        && data.durationDays is int
        && data.durationDays >= 1
        && data.durationDays <= 90
        && data.status == 'draft'
        && data.rewardPolicy ==
            'once_per_account_on_verified_submission'
        && data.revision is int
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdByUid is string
        && data.updatedByUid is string;
    }

    match /admin_survey_drafts/{surveyId} {
      allow get, list: if isGeneralManager();
      allow create: if isGeneralManager()
        && validAdminSurveyDraft(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isGeneralManager()
        && validAdminSurveyDraft(request.resource.data)
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft'
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'titleAr', 'titleEn', 'questions', 'rewardUnit',
          'rewardAmount', 'durationDays', 'updatedAt',
          'updatedByUid', 'revision'
        ]);
      allow delete: if false;
    }

    match /admin_audit/{auditId} {
      allow read: if hasAdminPermission('viewAudit')
        && !isProvinceAgent();
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /admin_history/{uid} {
      allow read: if isGeneralManager();
      allow write: if false;
    }

    match /system_counters/{counterId} {
      allow read, write: if isGeneralManager()
        || (
          counterId == 'place_approval'
          && hasAdminPermission('approvePlaces')
        );
    }
  }
}

// DEDA location sharing v1 deployment marker
