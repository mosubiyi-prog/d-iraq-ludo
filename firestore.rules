rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function sameAccount(accountKey) {
      return signedIn()
        && accountKey is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountKey == accountKey;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'lastSeenAt']);
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'fcmTokens', 'lastSeenAt', 'name', 'phone', 'accountType',
          'accountKey', 'createdAt', 'updatedAt', 'authMethod',
          'trustedInstallIds'
        ]);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fcmTokens', 'lastSeenAt', 'name', 'phone', 'accountType',
          'accountKey', 'createdAt', 'updatedAt', 'authMethod',
          'trustedInstallIds'
        ]);
      allow delete: if false;
    }

    // Public-to-the-signed-in-app account existence directory. It contains no
    // PIN or password. Individual documents can be fetched by a known phone key,
    // while collection listing is denied to reduce phone-number enumeration.
    match /deda_account_directory/{accountKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.token.email is string
        && request.resource.data.accountKey == accountKey
        && request.resource.data.authEmail == request.auth.token.email
        && request.resource.data.createdUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly([
          'accountKey', 'authEmail', 'active', 'createdUid',
          'createdAt', 'updatedAt'
        ]);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /recovery_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.accountKey is string
        && request.resource.data.phone is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.requesterInstallId is string
        && request.resource.data.keys().hasOnly([
          'requesterUid', 'requesterInstallId', 'accountKey', 'phone',
          'fullName', 'status', 'createdAt', 'updatedAt'
        ]);
      allow read: if isAdmin()
        || (signedIn() && resource.data.requesterUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // A newly generated recovery PIN is intentionally hidden from the admin UI.
    // Only the Firebase session that created the recovery request can read it.
    match /recovery_secrets/{requestId} {
      allow get: if signedIn()
        && resource.data.requesterUid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /support_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.type in ['company', 'problem', 'case', 'photo']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5;
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || sameAccount(resource.data.accountKey);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /place_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.placeName is string
        && request.resource.data.placeName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.governorate is string
        && request.resource.data.governorate.size() > 0
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.openingHours is string
        && request.resource.data.openingHours.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && (request.resource.data.category != 'other'
          || (request.resource.data.otherCategoryText is string
            && request.resource.data.otherCategoryText.size() > 0))
        && (request.resource.data.requestType != 'update'
          || (request.resource.data.originalPlaceId is string
            && exists(/databases/$(database)/documents/published_places/$(request.resource.data.originalPlaceId))
            && (
              get(/databases/$(database)/documents/published_places/$(request.resource.data.originalPlaceId)).data.ownerUid == request.auth.uid
              || sameAccount(get(/databases/$(database)/documents/published_places/$(request.resource.data.originalPlaceId)).data.accountKey)
            )));
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || sameAccount(resource.data.accountKey);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /published_places/{placeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && (resource.data.ownerUid == request.auth.uid
            || sameAccount(resource.data.accountKey))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAvailableNow', 'updatedAt']));
    }

    // Immutable audit trail for read-only admin account review.
    match /admin_audit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /system_counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
