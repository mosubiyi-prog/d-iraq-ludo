+  Future<void> _completeVerifiedLogin(
+    String normalizedPhone, {
+    String? verifiedName,
+    DedaAccountType? verifiedType,
+    String? verifiedUid,
+  }) async {
+    if (!mounted) {
+      if (verifiedUid != null) {
+        throw StateError('recovery-login-page-disposed-before-commit');
+      }
+      return;
+    }
+    if ((verifiedName == null) != (verifiedType == null)) {
+      throw StateError('incomplete-verified-owner-profile');
+    }
+    // The private new-phone path must still own the SAME original UID at
+    // the point local login state is written, never a previous phone's UID.
+    if (verifiedName != null &&
+        (verifiedUid == null || verifiedUid.isEmpty ||
+            FirebaseAuth.instance.currentUser?.uid != verifiedUid ||
+            FirebaseAuth.instance.currentUser?.isAnonymous != false ||
+            FirebaseAuth.instance.currentUser?.email !=
+                DedaOwnerUidContinuity.authEmail(normalizedPhone))) {
+      throw StateError('verified-original-uid-changed-before-login-commit');
+    }
+    final name = verifiedName ?? nameController.text.trim();
+    if (name.length < 2) {
+      _showLoginMessage(
+        'أدخل الاسم الكامل أولاً.',
+        'Enter your full name first.',
+      );
+      return;
+    }
+
+    final savedType = DedaPreferences.accountType;
+    final type = verifiedType ??
+        (savedType != null && DedaPreferences.accountPhone == normalizedPhone
+            ? savedType
+            : DedaAccountType.user);
+
+    await DedaPreferences.saveLogin(
+      name: name,
+      normalizedPhone: normalizedPhone,
+      type: type,
+      verifiedCanonicalProfile: verifiedName != null,
+      verifiedOriginalUid: verifiedUid,
+    );
+    // The verified replacement phone must load the RESTORED original points
+    // into the actual profile notifier before opening HomePage. Normal new
+    // account creation keeps the earlier nonblocking startup behavior.
+    if (verifiedUid != null && dedaStep2LevelPointsRestoreEnabled) {
+      await DedaTaskEngine.initializeForCurrentAccount();
+    }
+    if (verifiedUid != null &&
+        (FirebaseAuth.instance.currentUser?.uid != verifiedUid ||
+            FirebaseAuth.instance.currentUser?.isAnonymous != false ||
+            FirebaseAuth.instance.currentUser?.email !=
+                DedaOwnerUidContinuity.authEmail(normalizedPhone))) {
+      // Do not leave the wrong profile marked logged in after a session
+      // switch during the await on SharedPreferences.
+      await DedaPreferences.logout();
+      throw StateError('verified-original-uid-changed-during-login-commit');
+    }
+    if (!mounted) {
+      if (verifiedUid != null) {
+        if (DedaPreferences.accountPhone == normalizedPhone) {
+          await DedaPreferences.logout();
+        }
+        throw StateError('recovery-login-page-disposed-after-commit');
+      }
+      return;
+    }
+    Navigator.pushAndRemoveUntil(
+      context,
+      MaterialPageRoute(builder: (_) => HomePage(userName: name)),
+      (_) => false,
+    );
+  }
