    // DEDA stage2 domain-continuity candidate: LOCAL EMULATOR ONLY.
    // NEVER append to live firestore.rules without owner approval and review.
    // Social lookup is public-to-signed-in users ONLY for active IDs.
    match /deda_social_profiles/{publicId} {
      allow get: if signedIn()
        && exists(/databases/$(database)/documents/deda_share_ids/$(publicId))
        && get(/databases/$(database)/documents/deda_share_ids/$(publicId))
             .data.active == true
        && get(/databases/$(database)/documents/deda_share_ids/$(publicId))
             .data.kind == 'personal'
        // A missing social profile remains safely distinguishable from
        // permission-denied, so old 100340 accounts do not appear corrupted.
        && (resource == null || (
            // Friend lookup is public to signed-in users, but only when
            // the document contains this exact non-secret profile schema.
            // Any accidental phone, balance, session or admin field DENIES
            // reading the WHOLE document (Firestore has no field ACLs).
            resource.data.keys().hasOnly([
              'publicId','ownerUid','displayName','avatarStyle',
              'frameStyle','backgroundStyle','level','badges',
              'createdAt','updatedAt'
            ]) &&
            resource.data.publicId == publicId &&
            resource.data.ownerUid ==
              get(/databases/$(database)/documents/deda_share_ids/$(publicId))
                .data.ownerUid));
      allow list, create, update, delete: if false;
    }

    match /deda_friendships/{relationId} {
      // An array-contains query for the caller's UID can prove this
      // ownership predicate without exposing unfiltered friend listings.
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.members;
      allow create, update, delete: if false;
    }

    // Premium selection is an existing display choice, NOT ownership proof.
    match /deda_stage71_active_identifier/{originalId} {
      allow get: if signedIn()
        && currentUserHasShareId(originalId)
        && (resource == null || (
          resource.data.originalId == originalId &&
          resource.data.activeId is string));
      allow list, create, update, delete: if false;
    }

    match /deda_profile_ui_migration/{accountKey} {
      allow get: if sameAccount(accountKey)
        && (resource == null || (
            resource.data.accountKey == accountKey &&
            resource.data.uid == request.auth.uid &&
            currentUserHasShareId(resource.data.originalId) &&
            resource.data.kind == 'free-profile-appearance-only'));
      allow list, update, delete: if false;
      allow create: if sameAccount(accountKey)
        && request.resource.data.keys().hasOnly([
           'format','kind','accountKey','originalId','uid',
           'avatarStyle','backgroundStyle','createdAt'])
        && request.resource.data.keys().hasAll([
           'format','kind','accountKey','originalId','uid',
           'avatarStyle','backgroundStyle','createdAt'])
        && request.resource.data.format == 1
        && request.resource.data.kind == 'free-profile-appearance-only'
        && request.resource.data.accountKey == accountKey
        && request.resource.data.uid == request.auth.uid
        && currentUserHasShareId(request.resource.data.originalId)
        && request.resource.data.avatarStyle is int
        && request.resource.data.avatarStyle >= 0
        && request.resource.data.avatarStyle <= 5
        && request.resource.data.backgroundStyle is int
        && request.resource.data.backgroundStyle >= 0
        && request.resource.data.backgroundStyle <= 5
        && request.resource.data.createdAt == request.time;
    }

    match /deda_quiz_ui_snapshots/{ownerUid}/days/{day} {
      allow get: if signedIn() && request.auth.uid == ownerUid
        && (resource == null || (
            sameAccount(resource.data.accountKey) &&
            resource.data.uid == ownerUid &&
            resource.data.day == day &&
            currentUserHasShareId(resource.data.originalId) &&
            resource.data.kind == 'display-only-untrusted-quiz-v1'));
      allow list, update, delete: if false;
      allow create: if signedIn() && request.auth.uid == ownerUid
        && request.resource.data.keys().hasOnly([
          'format','kind','uid','accountKey','originalId','day',
          'encoded','createdAt'])
        && request.resource.data.keys().hasAll([
          'format','kind','uid','accountKey','originalId','day',
          'encoded','createdAt'])
        && request.resource.data.format == 1
        && request.resource.data.kind == 'display-only-untrusted-quiz-v1'
        && request.resource.data.uid == ownerUid
        && request.resource.data.day == day
        && day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && sameAccount(request.resource.data.accountKey)
        && currentUserHasShareId(request.resource.data.originalId)
        && request.resource.data.encoded is string
        && request.resource.data.encoded.size() <= 60000
        && request.resource.data.createdAt == request.time;
    }

    // Stage2 existing-asset READBACK ONLY — emulator-only candidate.
    // No client may mint, accept, transfer, debit, buy, or delete assets.
    // The original UID is preserved by linked owner login. Do not use active
    // premium aliases or client-entered phone numbers for authorization.
    function stage2OriginalAssetOwner(originalId) {
      return signedIn()
        && originalId is string
        && exists(/databases/$(database)/documents/deda_share_ids/$(originalId))
        && get(/databases/$(database)/documents/deda_share_ids/$(originalId))
             .data.publicId == originalId
        && get(/databases/$(database)/documents/deda_share_ids/$(originalId))
             .data.kind == 'personal'
        && get(/databases/$(database)/documents/deda_share_ids/$(originalId))
             .data.active == true
        && get(/databases/$(database)/documents/deda_share_ids/$(originalId))
             .data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/deda_sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.accountKey ==
           get(/databases/$(database)/documents/deda_sessions/$(request.auth.uid))
             .data.accountKey
        && (!get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.keys().hasAny(['sharePersonalId'])
            || get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.sharePersonalId == originalId);
    }

    match /deda_stage66_card_receipts/{receiptId} {
      allow get: if signedIn() && (resource == null || (
        resource.data.publicId is string
        && stage2OriginalAssetOwner(resource.data.publicId)
        && receiptId == resource.data.publicId + '_' + resource.data.style
        && resource.data.kind == 'card'
        && resource.data.style in ['gold','diamond','royal','pink']
        && resource.data.cost == 5000));
      allow list, create, update, delete: if false;
    }

    match /deda_stage66_owned_cards/{receiptId} {
      allow get: if signedIn() && (resource == null || (
        resource.data.publicId is string
        && stage2OriginalAssetOwner(resource.data.publicId)
        && receiptId == resource.data.publicId + '_' + resource.data.style
        && resource.data.style in ['gold','diamond','royal','pink']
        && resource.data.receiptId == receiptId));
      allow list, create, update, delete: if false;
    }

    match /deda_stage71_granted_registry/{identifier} {
      // Scoped recipient query only. Unfiltered registry enumeration denied.
      // A get may check the immutable document ID and grant schema.
      allow get: if signedIn()
        && resource.data.recipientOriginalId is string
        && stage2OriginalAssetOwner(resource.data.recipientOriginalId)
        && resource.data.identifier == identifier
        && resource.data.kind in ['self_used','gifted']
        && resource.data.group in ['001','002'];
      // Query rules cannot require a document-ID comparison or unqueried
      // kind/group fields: only the recipient filter is query-provable.
      // Dart source readback strictly validates every returned record.
      allow list: if signedIn()
        && stage2OriginalAssetOwner(resource.data.recipientOriginalId);
      allow create, update, delete: if false;
    }

    match /deda_stage74_id_gift_receipts/{identifier} {
      // A missing receipt means the allocated gift is still unaccepted.
      allow get: if signedIn() && (resource == null || (
        resource.data.originalId is string
        && stage2OriginalAssetOwner(resource.data.originalId)
        && resource.data.identifier == identifier
        && resource.data.group in ['001','002']));
      allow list, create, update, delete: if false;
    }

    // Candidate ONLY. The source is DEVICE-GLOBAL and owner-attributed
    // explicitly, not proof of the source installation or paid ownership.
    // One immutable original snapshot per canonical account; never auto-sync
    // or reuse these records as XP/diamonds/paid entitlements.
    match /deda_step2_global_place_archives/{accountKey} {
      allow get: if sameAccount(accountKey)
        && (resource == null || (
          resource.data.keys().hasOnly([
            'format','kind','accountKey','originalId','sourceUid',
            'captureId','encoded','createdAt'
          ]) &&
          resource.data.format == 1 &&
          resource.data.kind ==
            'untrusted-device-global-display-evidence' &&
          resource.data.accountKey == accountKey &&
          resource.data.sourceUid == request.auth.uid &&
          resource.data.originalId is string &&
          currentUserHasShareId(resource.data.originalId) &&
          resource.data.captureId is string &&
          resource.data.captureId.matches('^[a-f0-9]{48}$') &&
          resource.data.encoded is string &&
          resource.data.encoded.size() <= 650000 &&
          resource.data.createdAt is timestamp));
      allow list, update, delete: if false;
      allow create: if sameAccount(accountKey)
        && request.resource.data.keys().hasOnly([
          'format','kind','accountKey','originalId','sourceUid',
          'captureId','encoded','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'format','kind','accountKey','originalId','sourceUid',
          'captureId','encoded','createdAt'
        ])
        && request.resource.data.format == 1
        && request.resource.data.kind ==
          'untrusted-device-global-display-evidence'
        && request.resource.data.accountKey == accountKey
        && request.resource.data.sourceUid == request.auth.uid
        && request.resource.data.originalId is string
        && currentUserHasShareId(request.resource.data.originalId)
        && request.resource.data.captureId is string
        && request.resource.data.captureId.matches('^[a-f0-9]{48}$')
        && request.resource.data.encoded is string
        && request.resource.data.encoded.size() > 100
        && request.resource.data.encoded.size() <= 650000
        && request.resource.data.createdAt == request.time;
    }
