rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid &&
        uid == 'PLmG06Uhhheef1hDE2MLfX6DEpg2' &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }
    function valid(uid, d) {
      return d.keys().hasOnly(['format','uid','version','mutationId','payload','updatedAt']) &&
        d.keys().hasAll(['format','uid','version','mutationId','payload','updatedAt']) &&
        d.format == 1 && d.uid == uid && d.version is int &&
        d.version > 0 && d.version <= 9007199254740990 &&
        d.mutationId is string && d.mutationId.matches('^[a-f0-9]{48}$') &&
        d.payload is string && d.payload.size() <= 200000 && d.updatedAt == request.time;
    }
    function newReceipt(uid,d) {
      let path = /databases/$(database)/documents/deda_lab_uid_private/$(uid)/versions/$(d.mutationId);
      return !exists(path) && getAfter(path).data == d;
    }
    match /deda_lab_uid_private/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && valid(uid,request.resource.data) &&
        request.resource.data.version == 1 && newReceipt(uid,request.resource.data);
      allow update: if owner(uid) && valid(uid,request.resource.data) &&
        request.resource.data.version == resource.data.version + 1 &&
        newReceipt(uid,request.resource.data);
      allow list, delete: if false;
      match /versions/{id} {
        allow get: if owner(uid);
        allow create: if owner(uid) && valid(uid,request.resource.data) &&
          request.resource.data.mutationId == id &&
          getAfter(/databases/$(database)/documents/deda_lab_uid_private/$(uid)).data == request.resource.data &&
          (!exists(/databases/$(database)/documents/deda_lab_uid_private/$(uid)) ||
           get(/databases/$(database)/documents/deda_lab_uid_private/$(uid)).data.mutationId != id);
        allow list, update, delete: if false;
      }
    }
    // Financial/progression authority is server-only. No client minting.
    // This is a candidate lab namespace, not a deployed ledger or a balance.
    match /deda_lab_uid_authority/{uid} {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
      // Candidate only: owner may read the verified inventory projection.
      // Sources and history remain denied by the default rule.
      match /inventory/current {
        allow get: if owner(uid);
        allow list, create, update, delete: if false;
      }
      // UNPUBLISHED candidate: same owner-only account snapshot.
      // No client can produce this snapshot, its sources or its history.
      // Requests have no financial authority. Only the trusted demo worker
      // writes canonical task history, receipts, responses and quiz outcomes.
      match /taskCommands/{id} {
        allow get: if owner(uid);
        allow create: if owner(uid) && request.resource.data.keys().hasOnly([
          'format','uid','dayId','action','target','choice','selection','createdAt']) &&
          request.resource.data.keys().hasAll(['format','uid','dayId','action','target','choice','selection','createdAt']) &&
          request.resource.data.format == 1 && request.resource.data.uid == uid &&
          request.resource.data.dayId is string && request.resource.data.dayId.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$') &&
          request.resource.data.action in ['complete','claim','login','quiz_open','answer','ad_task','ad_diamonds'] &&
          request.resource.data.target is string && request.resource.data.target.matches('^[a-z0-9_]{1,96}$') &&
          id == request.resource.data.dayId + '__' + request.resource.data.action + '__' + request.resource.data.target &&
          request.resource.data.createdAt == request.time &&
          (request.resource.data.action == 'answer'
            ? request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
            : request.resource.data.choice == null) &&
          (request.resource.data.action == 'quiz_open'
            ? request.resource.data.selection is list && request.resource.data.selection.size() == 5
            : request.resource.data.selection == null);
        allow list, update, delete: if false;
      }
      match /taskAwardHistory/current { allow get: if owner(uid); allow list, write: if false; }
      match /taskResponses/{id} { allow get: if owner(uid); allow list, write: if false; }
      match /quizCycles/current { allow get: if owner(uid); allow list, write: if false; }
      match /dailyQuiz/{day} { allow get: if owner(uid); allow list, write: if false; }
      match /dailyAwards/{day} { allow get: if owner(uid); allow list, write: if false; }
      match /dailyLogin/{dayId} {
        allow get: if owner(uid);
        allow list, write: if false;
      }
      match /account/current {
        allow get: if owner(uid);
        allow list, create, update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
